{
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/referencias-sync",
      "schedule": "0 12 * * 1"
    },
    {
      "path": "/api/notificacoes-cleanup",
      "schedule": "0 4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
