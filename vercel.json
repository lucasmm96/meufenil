{
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/referencias-sync",
      "schedule": "0 12 * * 1"
    },
    {
      "path": "/api/notificacoes-cleanup",
      "schedule": "0 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
